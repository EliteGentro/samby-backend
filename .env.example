# Application
APP_NAME=Base Monolith API
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# Neon PostgreSQL (standard hosted URLs are normalized to psycopg automatically)
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/app?sslmode=require&channel_binding=require
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_MAX_CONNECTIONS=5

# Redis: keep the pool small and all application keys expiring on a free tier.
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=5
REDIS_DEFAULT_TTL_SECONDS=300
REDIS_EVENT_CHANNEL=app:events

# Native JWT authentication. Generate a long random secret for every environment.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=base-monolith-api
JWT_AUDIENCE=base-monolith-web
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI provider selection. Add another adapter and factory branch to change provider.
AI_PROVIDER=openrouter
AI_CONTEXT_MAX_TOKENS=12000
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Base Monolith
